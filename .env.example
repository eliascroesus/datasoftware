# ---------------------------------------------------------------------------
# Unived environment configuration
# Copy this file to `.env` (local) and set the same values in Vercel.
# ---------------------------------------------------------------------------

# Postgres connection string (required).
# Local dev example:  postgresql://unived@127.0.0.1:5433/unived
# Neon / Supabase / Vercel Postgres give you this string in their dashboard.
DATABASE_URL="postgresql://user:password@host:5432/unived?sslmode=require"

# 32+ char secret used to encrypt stored integration credentials at rest.
# Generate one with:  openssl rand -hex 32
CREDENTIALS_SECRET="change-me-to-a-long-random-string-min-32-chars"

# Secret that protects the /api/cron/sync endpoint so only Vercel Cron
# (or you) can trigger scheduled syncs. Generate with: openssl rand -hex 24
CRON_SECRET="change-me-cron-secret"

# Login wall. Set a password to require sign-in before anyone can view the app.
# If left unset, the app is open and shows a warning banner.
AUTH_PASSWORD="choose-a-strong-password"

# Optional: secret used to sign the session cookie. Defaults to CREDENTIALS_SECRET
# if omitted. Generate with: openssl rand -hex 32
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Google Sign-in (optional, but enables the 1-click Sheets picker)
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
#   → OAuth client ID → Web application
#   → Authorized redirect URI:  <YOUR_APP_URL>/api/oauth/google/callback
# Enable the "Google Drive API" and "Google Sheets API" for the project.
# Without these, Google Sheets falls back to a service-account / API-key form.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Contact email shown on the Privacy Policy and Terms pages.
# Defaults to support@namzilabs.co if unset.
NEXT_PUBLIC_CONTACT_EMAIL=""

# Public base URL of the deployed app (used to display webhook URLs).
# Vercel sets VERCEL_URL automatically; this overrides it if you have a domain.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
